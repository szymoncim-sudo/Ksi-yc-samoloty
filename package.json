{
  "name": "lunaris",
  "productName": "Lunaris",
  "version": "1.0.0",
  "description": "Lunaris — predicts aircraft crossing the Moon for the places you can stand",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "author": "Szymon",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "assets": "node scripts/make-assets.mjs",
    "electron": "vite build && electron .",
    "exe": "node scripts/build-exe.mjs",
    "deploy": "vite build && wrangler deploy",
    "shots": "vite build && electron . --shoot=docs/screens --only=phone && electron . --shoot=docs/screens --only=desktop"
  },
  "build": {
    "appId": "app.lunaris.transit",
    "productName": "Lunaris",
    "copyright": "Lunaris",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "shared/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}-${target}.${ext}"
    },
    "portable": {
      "artifactName": "Lunaris-Portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Lunaris-Setup.exe",
      "shortcutName": "Lunaris"
    }
  },
  "dependencies": {
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "astronomy-engine": "^2.1.19",
    "maplibre-gl": "^6.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "egm96-universal": "^1.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.168.0"
  }
}
